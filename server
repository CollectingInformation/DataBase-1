void SelectClient() {
    RefreshAllClients();
    ClearConsole();

    cout << "SELECT CLIENT\n";
    PrintSeparator();

    vector<shared_ptr<ClientInfo>> onlineClients;

    {
        lock_guard<mutex> lock(clientsMutex);

        for (const auto& client : clients) {
            if (client->connected.load()) {
                onlineClients.push_back(client);
            }
        }
    }

    if (onlineClients.empty()) {
        cout << "No online clients available.\n";
        WaitForEnter();
        return;
    }

    for (size_t i = 0; i < onlineClients.size(); ++i) {
        cout << "[" << i + 1 << "] "
            << onlineClients[i]->agentId
            << " [ONLINE]\n";
    }

    cout << "[" << onlineClients.size() + 1
        << "] Back\n";

    PrintSeparator();
    cout << "Select client: ";

    int choice = GetUserInput(
        1,
        static_cast<int>(onlineClients.size() + 1)
    );

    if (choice == static_cast<int>(onlineClients.size() + 1)) {
        return;
    }

    auto selected = onlineClients[choice - 1];

    if (!selected->connected.load()) {
        cout << "[ERROR] Client went offline.\n";
        WaitForEnter();
        return;
    }

    selectedClientId = selected->id;

    cout << "\nSelected: "
        << selected->agentId << '\n';

    WaitForEnter();
}

