int GetUserInput(int minimum, int maximum) {
    int value;

    while (!(cin >> value) ||
        value < minimum ||
        value > maximum) {

        cin.clear();
        cin.ignore(
            (numeric_limits<streamsize>::max)(),
            '\n'
        );

        cout << "Enter a number between "
            << minimum << " and " << maximum << ": ";
    }

    return value;
}

string GetCurrentTimestamp() {
    time_t now = time(nullptr);
    tm localTime{};

    localtime_s(&localTime, &now);

    stringstream output;
    output << put_time(&localTime, "%Y-%m-%d %H:%M:%S");

    return output.str();
}

string MakeAgentId(int id) {
    static const char digits[] = "0123456789ABCDEF";

    mt19937 generator(
        static_cast<unsigned int>(
            time(nullptr) ^ (id * 7919)
            )
    );

    uniform_int_distribution<int> distribution(0, 15);

    string result = "ID" + to_string(id) + " #";

    for (int i = 0; i < 11; ++i) {
        result += digits[distribution(generator)];
    }

    return result;
}

// ============================================================
// CLIENT LOOKUP
// ============================================================

shared_ptr<ClientInfo> FindClient(int id) {
    lock_guard<mutex> lock(clientsMutex);

    for (const auto& client : clients) {
        if (client->id == id) {
            return client;
        }
    }

    return nullptr;
}

int GetConnectedCount() {
    lock_guard<mutex> lock(clientsMutex);

    int count = 0;

    for (const auto& client : clients) {
        if (client->connected.load()) {
            ++count;
        }
    }

    return count;
}

// ============================================================
// CONNECTION STATUS CHECK
// ============================================================

bool RefreshClientStatus(
    const shared_ptr<ClientInfo>& client
) {
    if (!client) {
        return false;
    }

    lock_guard<mutex> socketLock(client->socketMutex);

    if (!client->connected.load() ||
        client->socketHandle == INVALID_SOCKET) {
        return false;
    }

    fd_set readSet;
    FD_ZERO(&readSet);
    FD_SET(client->socketHandle, &readSet);

    timeval timeout{};
    timeout.tv_sec = 0;
    timeout.tv_usec = 0;

    int result = select(
        0,
        &readSet,
        nullptr,
        nullptr,
        &timeout
    );

    if (result == SOCKET_ERROR) {
        closesocket(client->socketHandle);
        client->socketHandle = INVALID_SOCKET;
        client->connected = false;
        return false;
    }

    if (result > 0 &&
        FD_ISSET(client->socketHandle, &readSet)) {

        char peekBuffer = 0;

        int received = recv(
            client->socketHandle,
            &peekBuffer,
            1,
            MSG_PEEK
        );

        if (received == 0 || received == SOCKET_ERROR) {
            closesocket(client->socketHandle);
            client->socketHandle = INVALID_SOCKET;
            client->connected = false;
            return false;
        }
    }

    return client->connected.load();
}

void RefreshAllClients() {
    vector<shared_ptr<ClientInfo>> snapshot;

    {
        lock_guard<mutex> lock(clientsMutex);
        snapshot = clients;
    }

    for (const auto& client : snapshot) {
        RefreshClientStatus(client);
    }
}

// ============================================================
// CLIENT DISCONNECTION
// ============================================================

bool DisconnectClient(int id) {
    auto client = FindClient(id);

    if (!client) {
        cout << "[ERROR] Client ID not found.\n";
        return false;
    }

    lock_guard<mutex> socketLock(client->socketMutex);

    if (!client->connected.load() ||
        client->socketHandle == INVALID_SOCKET) {

        cout << "[INFO] Client is already offline.\n";
        return false;
    }

    shutdown(client->socketHandle, SD_BOTH);
    closesocket(client->socketHandle);

    client->socketHandle = INVALID_SOCKET;
    client->connected = false;

    cout << "[SERVER] Disconnected "
        << client->agentId << '\n';

    if (selectedClientId == id) {
        selectedClientId = -1;
    }

    return true;
}

// ============================================================
// CLIENT REGISTRATION
// ============================================================

void RegisterClient(
    SOCKET socketHandle,
    const sockaddr_in& remoteAddress
) {
    auto client = make_shared<ClientInfo>();

    client->id = nextClientId++;
    client->agentId = MakeAgentId(client->id);
    client->socketHandle = socketHandle;
    char ipBuffer[INET_ADDRSTRLEN]{};
    inet_ntop(AF_INET, &remoteAddress.sin_addr, ipBuffer, sizeof(ipBuffer));
    client->address = ipBuffer;
    client->port = ntohs(remoteAddress.sin_port);
    client->connectedAt = GetCurrentTimestamp();
    client->connected = true;

    {
        lock_guard<mutex> lock(clientsMutex);

        int onlineCount = 0;

        for (const auto& existing : clients) {
            if (existing->connected.load()) {
                ++onlineCount;
            }
        }

        if (onlineCount >= MAX_CLIENTS) {
            closesocket(socketHandle);
            cout << "[SERVER] Client limit reached.\n";
            return;
        }

        clients.push_back(client);
    }

    cout << "\n[SERVER] New local connection\n";
    cout << "Client ID : " << client->id << '\n';
    cout << "Agent     : " << client->agentId << '\n';
    cout << "Address   : " << client->address << '\n';
    cout << "Port      : " << client->port << '\n';
}

// ============================================================
// ACCEPT LOOP
// ============================================================

void AcceptLoop(SOCKET listeningSocket) {
    while (serverRunning) {
        sockaddr_in remoteAddress{};
        int addressLength = sizeof(remoteAddress);

        SOCKET newSocket = accept(
            listeningSocket,
            reinterpret_cast<sockaddr*>(&remoteAddress),
            &addressLength
        );

        if (newSocket == INVALID_SOCKET) {
            if (!serverRunning) {
                break;
            }

            continue;
        }

        // Localhost connections only.

        RegisterClient(newSocket, remoteAddress);
    }
}

// ============================================================
// SERVER START / STOP
// ============================================================

bool StartLocalServer() {
    WSADATA wsaData{};

    if (WSAStartup(MAKEWORD(2, 2), &wsaData) != 0) {
        cout << "[ERROR] WSAStartup failed.\n";
        return false;
    }

    listenerSocket = socket(
        AF_INET,
        SOCK_STREAM,
        IPPROTO_TCP
    );

    if (listenerSocket == INVALID_SOCKET) {
        cout << "[ERROR] Socket creation failed.\n";
        WSACleanup();
        return false;
    }

    sockaddr_in serverAddress{};

    serverAddress.sin_family = AF_INET;
    serverAddress.sin_port = htons(DEFAULT_PORT);

    if (inet_pton(
        AF_INET,
        DEFAULT_SERVER_IP.c_str(),
        &serverAddress.sin_addr
    ) != 1) {

        cout << "[ERROR] Invalid server address.\n";
        closesocket(listenerSocket);
        listenerSocket = INVALID_SOCKET;
        WSACleanup();
        return false;
    }

    if (bind(
        listenerSocket,
        reinterpret_cast<sockaddr*>(&serverAddress),
        sizeof(serverAddress)
    ) == SOCKET_ERROR) {

        cout << "[ERROR] Bind failed. Port may be in use.\n";
        closesocket(listenerSocket);
        listenerSocket = INVALID_SOCKET;
        WSACleanup();
        return false;
    }

    if (listen(listenerSocket, SOMAXCONN) == SOCKET_ERROR) {
        cout << "[ERROR] Listen failed.\n";
        closesocket(listenerSocket);
        listenerSocket = INVALID_SOCKET;
        WSACleanup();
        return false;
    }

    serverRunning = true;

    acceptThread = thread(
        AcceptLoop,
        listenerSocket
    );

    cout << "[SERVER] Listening on "
        << DEFAULT_SERVER_IP << ":"
        << DEFAULT_PORT << '\n';

    cout << "[SERVER] Multiple localhost connections enabled.\n";

    return true;
}

void StopLocalServer() {
    serverRunning = false;

    if (listenerSocket != INVALID_SOCKET) {
        shutdown(listenerSocket, SD_BOTH);
        closesocket(listenerSocket);
        listenerSocket = INVALID_SOCKET;
    }

    if (acceptThread.joinable()) {
        acceptThread.join();
    }

    vector<shared_ptr<ClientInfo>> snapshot;

    {
        lock_guard<mutex> lock(clientsMutex);
        snapshot = clients;
    }

    for (const auto& client : snapshot) {
        lock_guard<mutex> socketLock(client->socketMutex);

        if (client->socketHandle != INVALID_SOCKET) {
            shutdown(client->socketHandle, SD_BOTH);
            closesocket(client->socketHandle);

            client->socketHandle = INVALID_SOCKET;
        }

        client->connected = false;
    }

    WSACleanup();

    cout << "[SERVER] All local connections closed.\n";
}

