// ============================================================
// TCP COMMAND PROTOCOL
// ============================================================

constexpr uint32_t PROTOCOL_VERSION = 1;
constexpr uint32_t MESSAGE_REQUEST = 1;
constexpr uint32_t MESSAGE_RESPONSE = 2;
constexpr uint32_t STATUS_OK = 0;
constexpr uint32_t STATUS_ERROR = 1;
constexpr uint32_t COMMAND_GROUP_CORE = 0;
constexpr uint32_t COMMAND_GROUP_VIDEO = 1;
constexpr uint32_t COMMAND_PING = 1;
constexpr uint32_t VIDEO_START = 1;
constexpr uint32_t VIDEO_STOP = 2;
constexpr uint32_t VIDEO_SCREENSHOT = 3;

struct MessageHeader {
    uint32_t protocolVersion;
    uint32_t messageType;
    uint32_t commandId;
    uint32_t payloadSize;
    uint32_t status;
    uint32_t reserved; // command group
};

static_assert(sizeof(MessageHeader) == 24,
    "MessageHeader must be exactly 24 bytes.");

bool SendAll(SOCKET s, const char* data, int length) {
    int sent = 0;
    while (sent < length) {
        int n = send(s, data + sent, length - sent, 0);
        if (n <= 0) return false;
        sent += n;
    }
    return true;
}

bool ReceiveAll(SOCKET s, char* data, int length) {
    int received = 0;
    while (received < length) {
        int n = recv(s, data + received, length - received, 0);
        if (n <= 0) return false;
        received += n;
    }
    return true;
}

bool SendVideoCommand(const shared_ptr<ClientInfo>& client,
    uint32_t commandId, const string& payload, string& responseText) {
    if (!client) return false;
    lock_guard<mutex> socketLock(client->socketMutex);
    if (!client->connected.load() || client->socketHandle == INVALID_SOCKET)
        return false;

    MessageHeader request{};
    request.protocolVersion = PROTOCOL_VERSION;
    request.messageType = MESSAGE_REQUEST;
    request.commandId = commandId;
    request.payloadSize = static_cast<uint32_t>(payload.size());
    request.status = 0;
    request.reserved = COMMAND_GROUP_VIDEO;

    if (!SendAll(client->socketHandle,
        reinterpret_cast<const char*>(&request), sizeof(request))) return false;
    if (!payload.empty() && !SendAll(client->socketHandle,
        payload.data(), static_cast<int>(payload.size()))) return false;

    MessageHeader response{};
    if (!ReceiveAll(client->socketHandle,
        reinterpret_cast<char*>(&response), sizeof(response))) return false;
    if (response.protocolVersion != PROTOCOL_VERSION ||
        response.messageType != MESSAGE_RESPONSE ||
        response.commandId != commandId ||
        response.reserved != COMMAND_GROUP_VIDEO ||
        response.payloadSize > 4096) return false;

    vector<char> body(response.payloadSize);
    if (!body.empty() && !ReceiveAll(client->socketHandle,
        body.data(), static_cast<int>(body.size()))) return false;
    responseText.assign(body.begin(), body.end());
    return response.status == STATUS_OK;
}

