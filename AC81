static fs::path GetExecutableDirectory() {

    wchar_t buffer[32768]{};

    DWORD len =
        GetModuleFileNameW(
            nullptr,
            buffer,
            (DWORD)std::size(
                buffer
            )
        );

    if (len == 0)
        return fs::current_path();

    return fs::path(
        std::wstring(
            buffer,
            len
        )
    ).parent_path();
}

