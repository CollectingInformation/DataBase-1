int wmain() {

    SetConsoleOutputCP(
        CP_UTF8
    );

    SetConsoleCP(
        CP_UTF8
    );

    HRESULT comResult =
        CoInitializeEx(
            nullptr,
            COINIT_MULTITHREADED
        );

    bool comInitialized =
        SUCCEEDED(comResult);

    Config cfg;

    fs::path base =
        GetExecutableDirectory();

    fs::path logPath =
        base /
        L"anticheat.log";

    Logger logger(
        logPath
    );

    logger.Info(
        "CS2 AntiCheat v0.1.0"
    );

    logger.Info(
        "Built-in config enabled"
    );

    Reporter reporter(
        cfg,
        logger
    );

    AntiCheat ac(
        cfg,
        logger,
        reporter
    );

    ac.Run();

    if (comInitialized)
        CoUninitialize();

    return 0;
}
