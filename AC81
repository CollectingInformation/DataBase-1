        GetClientRect(
            hwnd,
            &rc
        );

        HBRUSH bg =
            CreateSolidBrush(
                RGB(
                    25,
                    25,
                    25
                )
            );

        FillRect(
            hdc,
            &rc,
            bg
        );

        DeleteObject(bg);

        SetBkMode(
            hdc,
            TRANSPARENT
        );

        SetTextColor(
            hdc,
            RGB(
                240,
                240,
                240
            )
        );

        if (gOverlayFont)
            SelectObject(
                hdc,
                gOverlayFont
            );

        DrawTextW(
            hdc,
            L"ENABLE AC",
            -1,
            &rc,
            DT_CENTER |
            DT_VCENTER |
            DT_SINGLELINE
        );

        EndPaint(
            hwnd,
            &ps
        );

        return 0;
    }

    default:

        return DefWindowProcW(
            hwnd,
            msg,
            wParam,
            lParam
        );
    }
}

static void ShowOverlayForSeconds(
    int seconds) {

    if (seconds <= 0)
        return;

    const wchar_t* cls =
        L"CS2_AC_OVERLAY_V04";

    HINSTANCE instance =
        GetModuleHandleW(
            nullptr
        );

    WNDCLASSW wc{};

    wc.lpfnWndProc =
        OverlayWndProc;

    wc.hInstance =
        instance;

    wc.lpszClassName =
        cls;

    RegisterClassW(&wc);

    gOverlayFont =
        CreateFontW(
            28,
            0,
            0,
            0,
            FW_SEMIBOLD,
            FALSE,
            FALSE,
            FALSE,
            DEFAULT_CHARSET,
            OUT_DEFAULT_PRECIS,
            CLIP_DEFAULT_PRECIS,
            CLEARTYPE_QUALITY,
            DEFAULT_PITCH |
            FF_DONTCARE,
            L"Segoe UI"
        );

    const int width =
        240;

    const int height =
        64;

    const int x =
        GetSystemMetrics(
            SM_CXSCREEN
        ) -
        width -
        25;

    const int y =
        30;

    HWND hwnd =
        CreateWindowExW(
            WS_EX_LAYERED |
            WS_EX_TRANSPARENT |
            WS_EX_TOPMOST |
            WS_EX_NOACTIVATE,
            cls,
            L"",
            WS_POPUP,
            x,
            y,
            width,
            height,
            nullptr,
            nullptr,
            instance,
            nullptr
        );

    if (!hwnd) {

        if (gOverlayFont) {

            DeleteObject(
                gOverlayFont
            );

            gOverlayFont =
                nullptr;
        }

        UnregisterClassW(
            cls,
            instance
        );

        return;
    }

    SetLayeredWindowAttributes(
        hwnd,
        0,
        225,
        LWA_ALPHA
    );

    ShowWindow(
        hwnd,
        SW_SHOWNOACTIVATE
    );

    UpdateWindow(hwnd);

    auto until =
        std::chrono::steady_clock::now() +
        std::chrono::seconds(
            seconds
        );

    MSG msg{};

    while (
        std::chrono::steady_clock::now() <
        until) {

        while (
            PeekMessageW(
                &msg,
                nullptr,
                0,
                0,
                PM_REMOVE)) {

            TranslateMessage(&msg);
            DispatchMessageW(&msg);
        }

        std::this_thread::sleep_for(
            std::chrono::milliseconds(
                25
            )
        );
    }

    DestroyWindow(hwnd);

    if (gOverlayFont) {

        DeleteObject(
            gOverlayFont
        );

        gOverlayFont =
            nullptr;
    }

    UnregisterClassW(
        cls,
        instance
    );
}

