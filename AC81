static std::wstring QueryProcessPath(
    HANDLE hProcess) {

    wchar_t path[32768]{};

    DWORD size =
        (DWORD)std::size(path);

    if (
        QueryFullProcessImageNameW(
            hProcess,
            0,
            path,
            &size)) {

        return std::wstring(
            path,
            size
        );
    }

    return {};
}

static DWORD FindProcessPid(
    const std::wstring& name) {

    HANDLE snap =
        CreateToolhelp32Snapshot(
            TH32CS_SNAPPROCESS,
            0
        );

    if (
        snap ==
        INVALID_HANDLE_VALUE) {

        return 0;
    }

    PROCESSENTRY32W pe{};

    pe.dwSize =
        sizeof(pe);

    DWORD result = 0;

    std::wstring wanted =
        ToLowerW(name);

    if (
        Process32FirstW(
            snap,
            &pe)) {

        do {

            if (
                ToLowerW(
                    pe.szExeFile
                ) ==
                wanted) {

                result =
                    pe.th32ProcessID;

                break;
            }

        } while (
            Process32NextW(
                snap,
                &pe
            )
            );
    }

    CloseHandle(snap);

    return result;
}

static bool GetProcessBasicInfo(
    DWORD pid,
    std::wstring& name,
    std::wstring& path,
    DWORD& parentPid) {

    name.clear();
    path.clear();
    parentPid = 0;

    HANDLE snap =
        CreateToolhelp32Snapshot(
            TH32CS_SNAPPROCESS,
            0
        );

    if (
        snap ==
        INVALID_HANDLE_VALUE) {

        return false;
    }

    PROCESSENTRY32W pe{};

    pe.dwSize =
        sizeof(pe);

    bool found = false;

    if (
        Process32FirstW(
            snap,
            &pe)) {

        do {

            if (
                pe.th32ProcessID ==
                pid) {

                name =
                    pe.szExeFile;

                parentPid =
                    pe.th32ParentProcessID;

                found = true;

                break;
            }

        } while (
            Process32NextW(
                snap,
                &pe
            )
            );
    }

    CloseHandle(snap);

    if (!found)
        return false;

    HANDLE process =
        OpenProcess(
            PROCESS_QUERY_LIMITED_INFORMATION,
            FALSE,
            pid
        );

    if (process) {

        path =
            QueryProcessPath(
                process
            );

        CloseHandle(process);
    }

    return true;
}

// ============================================================
// LAUNCH CHAIN
// ============================================================

static std::vector<ProcInfo>
BuildLaunchChain(
    DWORD pid) {

    std::vector<ProcInfo> chain;

    std::unordered_set<DWORD>
        visited;

    DWORD current =
        pid;

    for (
        int i = 0;
        i < 12 &&
        current != 0;
        ++i) {

        if (
            visited.count(
                current
            )) {

            break;
        }

        visited.insert(
            current
        );

        ProcInfo info;

        info.pid =
            current;

        if (
            !GetProcessBasicInfo(
                current,
                info.name,
                info.path,
                info.parentPid
            )) {

            break;
        }

        DWORD parentPid =
            info.parentPid;

        chain.push_back(
            std::move(info)
        );

        if (
            parentPid == 0 ||
            parentPid == current) {

            break;
        }

        current =
            parentPid;
    }

    return chain;
}

// ============================================================
// MODULE ENUMERATION
// ============================================================

static std::vector<ModuleInfo>
EnumerateModules(
    DWORD pid) {

    std::vector<ModuleInfo>
        result;

    HANDLE snap =
        CreateToolhelp32Snapshot(
            TH32CS_SNAPMODULE |
            TH32CS_SNAPMODULE32,
            pid
        );

    if (
        snap ==
        INVALID_HANDLE_VALUE) {

        return result;
    }

    MODULEENTRY32W me{};

    me.dwSize =
        sizeof(me);

    if (
        Module32FirstW(
            snap,
            &me)) {

        do {

            ModuleInfo info;

            info.pid =
                pid;

            info.name =
                me.szModule;

            info.path =
                me.szExePath;

            info.base =
                reinterpret_cast<uintptr_t>(
                    me.modBaseAddr
                    );

            info.size =
                me.modBaseSize;

            result.push_back(
                std::move(info)
            );

        } while (
            Module32NextW(
                snap,
                &me
            )
            );
    }

    CloseHandle(snap);

    return result;
}

