        const std::string& msg) {

        Write(
            "ERROR",
            msg
        );
    }

private:

    void Write(
        const char* level,
        const std::string& msg) {

        std::lock_guard<std::mutex> lock(
            mu_
        );

        std::ofstream f(
            path_,
            std::ios::app
        );

        auto now =
            std::chrono::system_clock::to_time_t(
                std::chrono::system_clock::now()
            );

        std::tm tm{};

        localtime_s(
            &tm,
            &now
        );

        if (f) {

            f
                << std::put_time(
                    &tm,
                    "%Y-%m-%d %H:%M:%S"
                )
                << " ["
                << level
                << "] "
                << msg
                << "\n";
        }

        std::cout
            << "["
            << level
            << "] "
            << msg
            << "\n";
    }

    fs::path path_;
    std::mutex mu_;
};

