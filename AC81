// SIGNATURE
// ============================================================

static SignatureState CheckSignature(
    const fs::path& path) {

    WINTRUST_FILE_INFO fi{};

    fi.cbStruct =
        sizeof(fi);

    fi.pcwszFilePath =
        path.c_str();

    GUID policy =
        WINTRUST_ACTION_GENERIC_VERIFY_V2;

    WINTRUST_DATA wd{};

    wd.cbStruct =
        sizeof(wd);

    wd.dwUIChoice =
        WTD_UI_NONE;

    wd.fdwRevocationChecks =
        WTD_REVOKE_NONE;

    wd.dwUnionChoice =
        WTD_CHOICE_FILE;

    wd.pFile =
        &fi;

    wd.dwStateAction =
        WTD_STATEACTION_IGNORE;

    wd.dwProvFlags =
        WTD_CACHE_ONLY_URL_RETRIEVAL;

    LONG status =
        WinVerifyTrust(
            nullptr,
            &policy,
            &wd
        );

    if (
        status ==
        ERROR_SUCCESS) {

        return SignatureState::Valid;
    }

    if (
        status ==
        TRUST_E_NOSIGNATURE ||
        status ==
        TRUST_E_SUBJECT_FORM_UNKNOWN ||
        status ==
        TRUST_E_PROVIDER_UNKNOWN) {

        return SignatureState::Invalid;
    }

    return SignatureState::Unknown;
}

