// --- НАША КАСЛЕННАЯ ФУНКЦИЯ-ФИЛЬТР ---
HMODULE WINAPI HookedLoadLibraryW(LPCWSTR lpLibFileName) {
    std::wstring dllName(lpLibFileName);

    // Проверяем, какую DLL пытается загрузить система или чит
    // Если в имени есть подозрительные слова, или это не системная DLL Windows
    if (dllName.find(L"cheat") != std::wstring::npos || dllName.find(L"hack") != std::wstring::npos) {

        // Шлем алерт админу, что была попытка инжекта!
        // ( player_name берется из глобальной переменной основного кода)
        std::wcout << L"[🚨] БЛОКИРОВКА: Попытка инжекта запрещенной DLL: " << lpLibFileName << std::endl;


        // Возвращаем NULL — чит думает, что функция сработала, но DLL НЕ ЗАГРУЗИТСЯ!
        return NULL;
    }

    // Если DLL легальная (например, системная от Windows или Steam Overlay)
    // Временно восстанавливаем оригинальные байты, чтобы не сломать игру
    DWORD oldProtect;
    VirtualProtect(LoadLibraryW, 5, PAGE_EXECUTE_READWRITE, &oldProtect);
    memcpy(LoadLibraryW, originalBytes, 5);

    // Вызываем настоящую функцию
    HMODULE hModule = LoadLibraryW(lpLibFileName);

    // Ставим хук обратно для защиты от следующих атак
    BYTE jump[5] = { 0xE9, 0x00, 0x00, 0x00, 0x00 };
    DWORD_PTR relativeAddress = (DWORD_PTR)HookedLoadLibraryW - (DWORD_PTR)LoadLibraryW - 5;
    memcpy(&jump[1], &relativeAddress, 4);
    memcpy(LoadLibraryW, jump, 5);
    VirtualProtect(LoadLibraryW, 5, oldProtect, &oldProtect);

    return hModule;
}

// --- ФУНКЦИЯ АКТИВАЦИИ ЗАЩИТЫ (СПЛАЙСИНГ) ---
void EnableAntiInject() {
    // Получаем адрес функции LoadLibraryW в памяти Windows
    void* targetFunction = (void*)LoadLibraryW;

    // Разрешаем чтение и запись в область системной функции
    DWORD oldProtect;
    VirtualProtect(targetFunction, 5, PAGE_EXECUTE_READWRITE, &oldProtect);

    // Сохраняем первые 5 оригинальных байт функции (чтобы потом вернуть как было)
    memcpy(originalBytes, targetFunction, 5);

    // Вычисляем относительный адрес для прыжка (JMP) на нашу HookedLoadLibraryW
    DWORD_PTR relativeAddress = (DWORD_PTR)HookedLoadLibraryW - (DWORD_PTR)targetFunction - 5;

    // Формируем инструкцию ассемблера: E9 [адрес_прыжка] (занимает ровно 5 байт)
    BYTE jump[5] = { 0xE9, 0x00, 0x00, 0x00, 0x00 };
    memcpy(&jump[1], &relativeAddress, 4);

    // Перезаписываем начало системной функции нашим прыжком
    memcpy(targetFunction, jump, 5);

    // Восстанавливаем настройки защиты памяти обратно
    VirtualProtect(targetFunction, 5, oldProtect, &oldProtect);

    std::cout << "[🟢] Защита от инжектов DLL успешно активирована.\n";
}

