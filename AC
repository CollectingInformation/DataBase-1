    SetConsoleOutputCP(CP_UTF8);
    SetConsoleCP(CP_UTF8);

    fs::path base = fs::current_path();
    fs::path configPath = base / L"config.json";
    fs::path logPath = base / L"anticheat.log";

    Config cfg = LoadConfig(configPath);
    Logger logger(logPath);
    logger.Info("CS2 AntiCheat v0.2 starting");

    Reporter reporter(cfg, logger);
    AntiCheat ac(cfg, logger, reporter);
    ac.Run();

    return 0;
}
