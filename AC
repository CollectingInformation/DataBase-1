static std::string WideToUtf8(const std::wstring& s) {
    if (s.empty()) return {};
    int n = WideCharToMultiByte(CP_UTF8, 0, s.data(), (int)s.size(), nullptr, 0, nullptr, nullptr);
    std::string out(n, '\0');
    WideCharToMultiByte(CP_UTF8, 0, s.data(), (int)s.size(), out.data(), n, nullptr, nullptr);
    return out;
}

static std::wstring Utf8ToWide(const std::string& s) {
    if (s.empty()) return {};
    int n = MultiByteToWideChar(CP_UTF8, 0, s.data(), (int)s.size(), nullptr, 0);
    std::wstring out(n, L'\0');
    MultiByteToWideChar(CP_UTF8, 0, s.data(), (int)s.size(), out.data(), n);
    return out;
}

static std::string JsonEscape(const std::string& s) {
    std::ostringstream o;
    for (char c : s) {
        switch (c) {
        case '\"': o << "\\\""; break;
        case '\\': o << "\\\\"; break;
        case '\n': o << "\\n"; break;
        case '\r': o << "\\r"; break;
        case '\t': o << "\\t"; break;
        default: o << c;
        }
    }
    return o.str();
}

static std::string JsonEscapeW(const std::wstring& s) {
    return JsonEscape(WideToUtf8(s));
}

class Logger {
public:
    explicit Logger(const fs::path& path) : path_(path) {}

    void Info(const std::string& msg) { Write("INFO", msg); }
    void Warn(const std::string& msg) { Write("WARN", msg); }
    void Error(const std::string& msg) { Write("ERROR", msg); }

private:
    void Write(const char* level, const std::string& msg) {
        std::lock_guard<std::mutex> lock(mu_);
        std::ofstream f(path_, std::ios::app);
        auto now = std::chrono::system_clock::to_time_t(std::chrono::system_clock::now());
        std::tm tm{};
        localtime_s(&tm, &now);
        f << std::put_time(&tm, "%Y-%m-%d %H:%M:%S")
          << " [" << level << "] " << msg << "\n";
        std::cout << "[" << level << "] " << msg << "\n";
    }
    fs::path path_;
    std::mutex mu_;
};

static bool ReadWholeFile(const fs::path& path, std::string& out) {
    std::ifstream f(path, std::ios::binary);
    if (!f) return false;
    std::ostringstream ss;
    ss << f.rdbuf();
    out = ss.str();
    return true;
}

static std::string GetJsonString(const std::string& text, const std::string& key, const std::string& fallback) {
    std::string needle = "\"" + key + "\"";
    size_t p = text.find(needle);
    if (p == std::string::npos) return fallback;
    p = text.find(':', p + needle.size());
    if (p == std::string::npos) return fallback;
    p = text.find('"', p + 1);
    if (p == std::string::npos) return fallback;
    size_t e = text.find('"', p + 1);
    if (e == std::string::npos) return fallback;
    return text.substr(p + 1, e - p - 1);
}

static int GetJsonInt(const std::string& text, const std::string& key, int fallback) {
    std::string needle = "\"" + key + "\"";
    size_t p = text.find(needle);
    if (p == std::string::npos) return fallback;
    p = text.find(':', p + needle.size());
    if (p == std::string::npos) return fallback;
    ++p;
    while (p < text.size() && isspace((unsigned char)text[p])) ++p;
    try { return std::stoi(text.substr(p)); } catch (...) { return fallback; }
}

static bool GetJsonBool(const std::string& text, const std::string& key, bool fallback) {
    std::string needle = "\"" + key + "\"";
    size_t p = text.find(needle);
    if (p == std::string::npos) return fallback;
    p = text.find(':', p + needle.size());
    if (p == std::string::npos) return fallback;
    std::string tail = text.substr(p + 1, 16);
    if (tail.find("true") != std::string::npos) return true;
    if (tail.find("false") != std::string::npos) return false;
    return fallback;
}

static Config LoadConfig(const fs::path& path) {
    Config c;
    std::string s;
    if (!ReadWholeFile(path, s)) return c;
    c.gameProcess = Utf8ToWide(GetJsonString(s, "game_process", WideToUtf8(c.gameProcess)));
    c.scanIntervalMs = GetJsonInt(s, "scan_interval_ms", c.scanIntervalMs);
    c.heartbeatIntervalMs = GetJsonInt(s, "heartbeat_interval_ms", c.heartbeatIntervalMs);
    c.serverHost = GetJsonString(s, "server_host", c.serverHost);
    c.serverPort = GetJsonInt(s, "server_port", c.serverPort);
    c.reportUnsignedProcesses = GetJsonBool(s, "report_unsigned_processes", c.reportUnsignedProcesses);
    return c;
}

static std::wstring ToLowerW(std::wstring s) {
    std::transform(s.begin(), s.end(), s.begin(), towlower);
    return s;
}

static std::string Sha256File(const fs::path& path) {
    HANDLE hFile = CreateFileW(path.c_str(), GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
                               nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
    if (hFile == INVALID_HANDLE_VALUE) return {};

    HCRYPTPROV hProv = 0;
    HCRYPTHASH hHash = 0;
    std::string result;

    if (!CryptAcquireContextW(&hProv, nullptr, nullptr, PROV_RSA_AES, CRYPT_VERIFYCONTEXT) &&
        GetLastError() != NTE_BAD_KEYSET) {
        CloseHandle(hFile);
        return {};
    }
    if (!hProv && !CryptAcquireContextW(&hProv, nullptr, nullptr, PROV_RSA_FULL, CRYPT_VERIFYCONTEXT)) {
        CloseHandle(hFile);
        return {};
    }

    if (!CryptCreateHash(hProv, CALG_SHA_256, 0, 0, &hHash)) {
        CryptReleaseContext(hProv, 0);
        CloseHandle(hFile);
        return {};
    }

    std::vector<BYTE> buf(1024 * 1024);
    DWORD read = 0;
    while (ReadFile(hFile, buf.data(), (DWORD)buf.size(), &read, nullptr) && read) {
        if (!CryptHashData(hHash, buf.data(), read, 0)) {
            CryptDestroyHash(hHash);
            CryptReleaseContext(hProv, 0);
            CloseHandle(hFile);
            return {};
        }
    }

    BYTE hash[32];
    DWORD hashLen = sizeof(hash);
    if (CryptGetHashParam(hHash, HP_HASHVAL, hash, &hashLen, 0)) {
        std::ostringstream oss;
        for (DWORD i = 0; i < hashLen; ++i)
            oss << std::hex << std::setw(2) << std::setfill('0') << (int)hash[i];
        result = oss.str();
    }

    CryptDestroyHash(hHash);
    CryptReleaseContext(hProv, 0);
    CloseHandle(hFile);
    return result;
}

static bool IsDigitallySigned(const fs::path& path) {
    WINTRUST_FILE_INFO fi{};
    fi.cbStruct = sizeof(fi);
    fi.pcwszFilePath = path.c_str();

    GUID policy = WINTRUST_ACTION_GENERIC_VERIFY_V2;
    WINTRUST_DATA wd{};
    wd.cbStruct = sizeof(wd);
    wd.dwUIChoice = WTD_UI_NONE;
    wd.fdwRevocationChecks = WTD_REVOKE_NONE;
    wd.dwUnionChoice = WTD_CHOICE_FILE;
    wd.pFile = &fi;
    wd.dwStateAction = WTD_STATEACTION_IGNORE;
    wd.dwProvFlags = WTD_CACHE_ONLY_URL_RETRIEVAL;

    LONG status = WinVerifyTrust(nullptr, &policy, &wd);
    return status == ERROR_SUCCESS;
}

static std::wstring QueryProcessPath(HANDLE hProcess) {
    wchar_t path[MAX_PATH * 4]{};
    DWORD size = (DWORD)std::size(path);
    if (QueryFullProcessImageNameW(hProcess, 0, path, &size))
        return std::wstring(path, size);
    return {};
}

static DWORD QueryParentPid(DWORD pid) {
    HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
    if (snap == INVALID_HANDLE_VALUE) return 0;

    PROCESSENTRY32W pe{};
    pe.dwSize = sizeof(pe);
    DWORD parent = 0;

    if (Process32FirstW(snap, &pe)) {
        do {
            if (pe.th32ProcessID == pid) {
                parent = pe.th32ParentProcessID;
                break;
            }
        } while (Process32NextW(snap, &pe));
    }
    CloseHandle(snap);
    return parent;
}

struct ProcInfo {
    DWORD pid{};
    DWORD parentPid{};
    std::wstring name;
    std::wstring path;
    std::string sha256;
    bool signedFile{};
};

class Reporter {
public:
    Reporter(const Config& c, Logger& log) : cfg_(c), log_(log) {
        WSAStartup(MAKEWORD(2, 2), &wsa_);
    }

    ~Reporter() { WSACleanup(); }

    void SendEvent(const std::string& json) {
        log_.Info("EVENT " + json);

        SOCKET s = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
        if (s == INVALID_SOCKET) return;

        sockaddr_in addr{};
        addr.sin_family = AF_INET;
        addr.sin_port = htons((u_short)cfg_.serverPort);

        if (InetPtonA(AF_INET, cfg_.serverHost.c_str(), &addr.sin_addr) != 1) {
            addrinfo hints{};
            hints.ai_family = AF_INET;
            hints.ai_socktype = SOCK_STREAM;
            addrinfo* result = nullptr;

            if (getaddrinfo(cfg_.serverHost.c_str(), nullptr, &hints, &result) != 0 || !result) {
                closesocket(s);
                return;
            }

            auto* ipv4 = reinterpret_cast<sockaddr_in*>(result->ai_addr);
            addr.sin_addr = ipv4->sin_addr;
            freeaddrinfo(result);
        }

        // Short timeout; failure to reach the local server must not block the scanner.
        DWORD timeoutMs = 500;
        setsockopt(s, SOL_SOCKET, SO_SNDTIMEO, (const char*)&timeoutMs, sizeof(timeoutMs));
        setsockopt(s, SOL_SOCKET, SO_RCVTIMEO, (const char*)&timeoutMs, sizeof(timeoutMs));

        if (connect(s, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) == 0) {
            std::string payload = json + "\n";
            send(s, payload.data(), (int)payload.size(), 0);
        }
        closesocket(s);
    }

private:
    const Config& cfg_;
    Logger& log_;
    WSADATA wsa_{};
};

class AntiCheat {
public:
    AntiCheat(Config cfg, Logger& log, Reporter& reporter)
        : cfg_(std::move(cfg)), log_(log), reporter_(reporter) {
        wchar_t buf[MAX_PATH]{};
        GetModuleFileNameW(nullptr, buf, MAX_PATH);
        selfPath_ = fs::path(buf);
        sessionId_ = MakeSessionId();
    }

    void Run() {
        log_.Info("session=" + sessionId_);
        reporter_.SendEvent(EventJson("session_start", "session=" + sessionId_));

        std::thread scanner(&AntiCheat::ScannerLoop, this);
        std::thread heartbeat(&AntiCheat::HeartbeatLoop, this);
        std::thread watchdog(&AntiCheat::WatchdogLoop, this);

        scanner.join();
        heartbeat.join();
        watchdog.join();
    }

private:
    std::string MakeSessionId() {
        GUID g{};
        CoCreateGuid(&g);
        wchar_t s[64]{};
        StringFromGUID2(g, s, 64);
        std::wstring w(s);
        w.erase(std::remove(w.begin(), w.end(), L'{'), w.end());
        w.erase(std::remove(w.begin(), w.end(), L'}'), w.end());
        return WideToUtf8(w);
    }

    std::string EventJson(const std::string& type, const std::string& detail) {
        std::ostringstream o;
        o << "{\"event\":\"" << JsonEscape(type)
          << "\",\"session_id\":\"" << JsonEscape(sessionId_)
          << "\",\"detail\":\"" << JsonEscape(detail) << "\"}";
        return o.str();
    }

    bool IsAllowed(const std::wstring& name) const {
        auto n = ToLowerW(name);
        for (const auto& a : cfg_.allowedProcesses)
            if (n == ToLowerW(a)) return true;
        return false;
    }

    bool IsSuspiciousName(const std::wstring& name) const {
        auto n = ToLowerW(name);
        for (const auto& bad : cfg_.suspiciousNames) {
            if (n == ToLowerW(bad)) return true;
        }
        return false;
    }

    std::vector<ProcInfo> EnumerateProcesses() {
        std::vector<ProcInfo> out;
        HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
        if (snap == INVALID_HANDLE_VALUE) return out;

        PROCESSENTRY32W pe{};
        pe.dwSize = sizeof(pe);

        if (Process32FirstW(snap, &pe)) {
            do {
                if (!pe.th32ProcessID) continue;

                HANDLE h = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION | PROCESS_VM_READ, FALSE, pe.th32ProcessID);
                if (!h) continue;

                ProcInfo p;
                p.pid = pe.th32ProcessID;
                p.parentPid = QueryParentPid(p.pid);
                p.name = pe.szExeFile;
                p.path = QueryProcessPath(h);
                if (!p.path.empty()) {
                    p.sha256 = Sha256File(p.path);
                    p.signedFile = IsDigitallySigned(p.path);
                }
                CloseHandle(h);
                out.push_back(std::move(p));
            } while (Process32NextW(snap, &pe));
        }

        CloseHandle(snap);
        return out;
    }

    bool IsGameRunning() {
        auto list = EnumerateProcesses();
        for (const auto& p : list)
            if (ToLowerW(p.name) == ToLowerW(cfg_.gameProcess))
                return true;
        return false;
    }

    void ScannerLoop() {
        while (!stop_) {
            auto list = EnumerateProcesses();

            for (const auto& p : list) {
                bool suspicious = IsSuspiciousName(p.name);
                bool unknownUnsigned = cfg_.reportUnsignedProcesses && !IsAllowed(p.name) && !p.signedFile;

                if (!suspicious && !unknownUnsigned) continue;

                // De-duplicate by PID + hash so an event isn't generated every scan.
                std::string key = std::to_string(p.pid) + ":" + p.sha256;
                if (!reported_.insert(key).second) continue;

                std::ostringstream detail;
                detail << "name=" << JsonEscapeW(p.name)
                       << ";pid=" << p.pid
                       << ";ppid=" << p.parentPid
                       << ";signed=" << (p.signedFile ? "true" : "false")
                       << ";sha256=" << p.sha256
                       << ";path=" << JsonEscapeW(p.path)
                       << ";reason=" << (suspicious ? "suspicious_name" : "unknown_unsigned");

                log_.Warn(detail.str());
                reporter_.SendEvent(EventJson("process_alert", detail.str()));
            }

            std::this_thread::sleep_for(std::chrono::milliseconds(std::max(250, cfg_.scanIntervalMs)));
        }
    }

    void HeartbeatLoop() {
        while (!stop_) {
            bool game = IsGameRunning();
            std::ostringstream d;
            d << "game_running=" << (game ? "true" : "false")
              << ";uptime_sec=" << (GetTickCount64() / 1000);
            reporter_.SendEvent(EventJson("heartbeat", d.str()));
            std::this_thread::sleep_for(std::chrono::milliseconds(std::max(1000, cfg_.heartbeatIntervalMs)));
        }
    }

    void WatchdogLoop() {
        const auto started = std::chrono::steady_clock::now();
        while (!stop_) {
            // Detect a hanging main loop at a coarse level. This does not terminate CS2.
            auto age = std::chrono::duration_cast<std::chrono::seconds>(
                std::chrono::steady_clock::now() - started).count();
            if (age > 0) {
                // Keep the process responsive and publish a lightweight watchdog heartbeat.
                reporter_.SendEvent(EventJson("watchdog", "alive=true"));
            }
            std::this_thread::sleep_for(std::chrono::seconds(10));
        }
    }

    Config cfg_;
    Logger& log_;
    Reporter& reporter_;
    fs::path selfPath_;
    std::string sessionId_;
    std::unordered_set<std::string> reported_;
    std::atomic<bool> stop_{false};
};

