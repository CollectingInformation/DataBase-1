    // Проверяем аргументы командной строки
    // Если программа запущена с флагом "--helper", включаем фоновую защиту
    if (argc > 1 && std::string(argv[1]) == "--helper") {

        // На всякий случай жестко скрываем окно консоли, если Windows попытается его отобразить
        HWND hwnd = GetConsoleWindow();
        if (hwnd) ShowWindow(hwnd, SW_HIDE);

        RunAsHelper(); // Запуск логики хелпера
    }
    // Если запущен обычным двойным кликом — это главный античит для игрока
    else {
        // Настраиваем кодировку консоли Windows под русский язык
        SetConsoleCP(1251);
        SetConsoleOutputCP(1251);

        RunAsAntiCheat(); // Запуск логики главного античета
    }
    return 0;
}
