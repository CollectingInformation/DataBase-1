// --- ФУНКЦИЯ ОТПРАВКИ ЛОГОВ ПО СЕТИ (WINSOCK2) ---
void SendAlertToAdmin(const std::string& message) {
    // 1. Инициализируем сетевую подсистему Windows (Winsock)
    WSADATA wsData;
    WORD ver = MAKEWORD(2, 2);
    int wsResult = WSAStartup(ver, &wsData);
    if (wsResult != 0) {
        return; // Если сеть Windows повреждена, выходим
    }

    // 2. Создаем сокет (виртуальный разъем связи)
    SOCKET sock = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
    if (sock == INVALID_SOCKET) {
        WSACleanup();
        return;
    }

    // 3. Настраиваем адрес назначения (IP и Порт админки)
    sockaddr_in hint;
    hint.sin_family = AF_INET;
    hint.sin_port = htons(ADMIN_PORT);
    inet_pton(AF_INET, ADMIN_IP.c_str(), &hint.sin_addr);

    // 4. Пытаемся подключиться к серверу админа
    int connResult = connect(sock, (sockaddr*)&hint, sizeof(hint));
    if (connResult != SOCKET_ERROR) {
        // Если подключение успешно — отправляем текст сообщения
        send(sock, message.c_str(), (int)message.length(), 0);
    }

    // 5. Корректно закрываем сокет и очищаем сетевую память за собой
    closesocket(sock);
    WSACleanup();
}

// --- ФУНКЦИЯ ПОИСКА ПРОЦЕССА ПО ИМЕНИ ---
DWORD GetPidByName(const std::wstring& procName) {
    PROCESSENTRY32W pe32;
    pe32.dwSize = sizeof(PROCESSENTRY32W);

    // Делаем снимок всех активных процессов в Windows
    HANDLE hSnapshot = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
    if (hSnapshot == INVALID_HANDLE_VALUE) return 0;

    // Перебираем процессы в цикле
    if (Process32FirstW(hSnapshot, &pe32)) {
        do {
            // Сравниваем имя текущего процесса с искомым (без учета регистра букв)
            if (_wcsicmp(pe32.szExeFile, procName.c_str()) == 0) {
                CloseHandle(hSnapshot);
                return pe32.th32ProcessID; // Нашли! Возвращаем его ID
            }
        } while (Process32NextW(hSnapshot, &pe32));
    }

    CloseHandle(hSnapshot);
    return 0; // Процесс не запущен
}

// --- ФУНКЦИЯ ПРИНУДИТЕЛЬНОГО ЗАКРЫТИЯ ИГРЫ ---
void KillProcess(DWORD pid) {
    if (pid == 0) return;
    // Открываем процесс игры с правами на его уничтожение
    HANDLE hProcess = OpenProcess(PROCESS_TERMINATE, FALSE, pid);
    if (hProcess) {
        TerminateProcess(hProcess, 0); // Жестко тушим игру
        CloseHandle(hProcess);
    }
}

// --- РЕЖИМ РАБОТЫ №1: СКРЫТЫЙ ФОНОВЫЙ ХЕЛПЕР ---
void RunAsHelper() {
    // Ждем 2 секунды, чтобы главное окно успело полностью проинициализироваться
    Sleep(2000);

    // Бесконечный цикл мониторинга главного окна
    while (true) {
        // Если главный античит пропал из процессов — значит читер его закрыл
        if (GetPidByName(MAIN_EXE) == 0) {
            // Ищем запущенную игру
            DWORD gamePid = GetPidByName(TARGET_GAME);
            if (gamePid != 0) {
                KillProcess(gamePid); // Закрываем игру аварийно
            }

            // Шлем экстренный лог админу
            SendAlertToAdmin("🚨 КРИТ: Игрок принудительно ЗАКРЫЛ основное окно античета (anticheat.exe)! Игра экстренно завершена.");
            return; // Хелпер завершает работу
        }
        Sleep(1000); // Проверяем каждую секунду, чтобы не грузить CPU
    }
}

// --- РЕЖИМ РАБОТЫ №2: ГЛАВНЫЙ АНТИЧИТ ---
void RunAsAntiCheat() {
    std::cout << "v0.1.0\n";


    std::cout << "[?] Введите ваш Ник или ID для турнира: ";
    std::cin >> player_name;

    // КЛОНИРОВАНИЕ: Узнаем полный путь, где лежит текущий запущенный .exe
    wchar_t currentPath[MAX_PATH];
    GetModuleFileNameW(NULL, currentPath, MAX_PATH);

    // Автоматически создаем физическую копию себя под именем ac_helper.exe
    // Копирование сработает, только если файла еще нет или он не запущен
    CopyFileW(currentPath, HELPER_EXE.c_str(), FALSE);

    // НАСТРОЙКА ЗАПУСКА: Запускаем созданный ac_helper.exe
    STARTUPINFOW si;
    PROCESS_INFORMATION pi;
    ZeroMemory(&si, sizeof(si));
    si.cb = sizeof(si);
    ZeroMemory(&pi, sizeof(pi));

    // Секретный аргумент "--helper" сообщает программе, что она должна включить скрытый режим
    std::wstring commandLine = HELPER_EXE + L" --helper";

    // Запускаем процесс БЕЗ ОКОН (флаг CREATE_NO_WINDOW)
    if (CreateProcessW(HELPER_EXE.c_str(), &commandLine[0], NULL, NULL, FALSE, CREATE_NO_WINDOW, NULL, NULL, &si, &pi)) {
        std::cout << "[+]\n";
        CloseHandle(pi.hProcess);
        CloseHandle(pi.hThread);
    }
    else {
        std::cout << "[-]\n";
        system("pause");
        return;
    }

    // Отправляем админу лог, что игрок успешно вошел в систему защиты
    SendAlertToAdmin("[" + player_name + "] online");
    std::cout << "\n[+]\n";

    // Базовый черный список читов для проверки процессов
    std::vector<std::wstring> bad_procs = { L"cheatengine-x86_64.exe", L"extremeinjector.exe", L"cheat_loader.exe" };

    // Бесконечный цикл сканирования
    while (true) {
        // 1. Проверяем, жив ли наш хелпер
        if (GetPidByName(HELPER_EXE) == 0) {
            SendAlertToAdmin("🚨 КРИТ: Игрок [" + player_name + "] принудительно СНЯЛ процесс хелпера (ac_helper.exe)!");
            DWORD gamePid = GetPidByName(TARGET_GAME);
            if (gamePid != 0) KillProcess(gamePid);
            return;
        }

        // 2. Сканируем систему на запущенные читы из черного списка
        for (const auto& bad : bad_procs) {
            if (GetPidByName(bad) != 0) {
                SendAlertToAdmin("🚨 ЧИТ: У игрока [" + player_name + "] обнаружен запущенный софт из черного списка!");
                DWORD gamePid = GetPidByName(TARGET_GAME);
                if (gamePid != 0) KillProcess(gamePid); // Моментально закрываем игру
                return;
            }
        }

        Sleep(1500); // Проверка каждые 1.5 секунды
    }
}

