    c.scanIntervalMs = GetJsonInt(s, "scan_interval_ms", c.scanIntervalMs);
    c.heartbeatIntervalMs = GetJsonInt(s, "heartbeat_interval_ms", c.heartbeatIntervalMs);
    c.serverHost = GetJsonString(s, "server_host", c.serverHost);
    c.serverPort = GetJsonInt(s, "server_port", c.serverPort);
    c.authToken = GetJsonString(s, "auth_token", c.authToken);
