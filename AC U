        return false;
    }

    bool IsSuspiciousName(const std::wstring & name) const {
        auto n = ToLowerW(name);
        for (const auto& bad : cfg_.suspiciousNames) {
            if (n == ToLowerW(bad)) return true;
        }
        return false;
    }

    bool IsTrustedSystemPath(const std::wstring & path) const {
        const auto p = ToLowerW(path);
        for (const auto& prefix : cfg_.trustedPathPrefixes)
            if (p.rfind(ToLowerW(prefix), 0) == 0) return true;
        return false;
    }

    CachedFile GetFileEvidence(const fs::path & path) {
        std::error_code ec;
        auto size = fs::file_size(path, ec);
        if (ec) return {};
        auto wt = fs::last_write_time(path, ec);
        if (ec) return {};
        auto key = ToLowerW(path.wstring());
        auto it = fileCache_.find(key);
        if (it != fileCache_.end() && it->second.size == size && it->second.writeTime == wt)
            return it->second;
        CachedFile e;
        e.size = size;
        e.writeTime = wt;
        e.sha256 = Sha256File(path);
        e.hashState = e.sha256.empty() ? HashState::Failed : HashState::Valid;
        e.signature = CheckSignature(path);
        fileCache_[key] = e;
        return e;
    }

    int CalculateRisk(const ProcInfo & p, std::string & reason) const {
        int score = 0;
        const bool suspicious = IsSuspiciousName(p.name);
        const bool allowed = IsAllowed(p.name);
        const bool systemPath = IsTrustedSystemPath(p.path);

        if (suspicious) { score += 80; reason += "known_suspicious_name;"; }
        if (p.signature == SignatureState::Invalid && !systemPath) { score += 15; reason += "invalid_signature;"; }
        if (p.signature == SignatureState::Unknown) reason += "signature_unknown;";
        if (p.hashState == HashState::Failed) reason += "hash_unavailable;";
        if (!allowed && !systemPath && p.signature == SignatureState::Invalid) {
            score += 10; reason += "unknown_unsigned_non_system;";
        }
        if (systemPath && score < 50) { score = std::min(score, 10); reason += "trusted_system_path;"; }
        if (score == 0) reason = "low_signal;";
        return score;
    }

    std::vector<ProcInfo> EnumerateProcesses() {
        std::vector<ProcInfo> out;
        HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
        if (snap == INVALID_HANDLE_VALUE) return out;

        PROCESSENTRY32W pe{};
        pe.dwSize = sizeof(pe);

        if (Process32FirstW(snap, &pe)) {
            do {
                if (!pe.th32ProcessID) continue;

                HANDLE h = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION | PROCESS_VM_READ, FALSE, pe.th32ProcessID);
                if (!h) continue;

                ProcInfo p;
                p.pid = pe.th32ProcessID;
                p.parentPid = QueryParentPid(p.pid);
                p.name = pe.szExeFile;
                p.path = QueryProcessPath(h);
                if (!p.path.empty()) {
                    auto evidence = GetFileEvidence(p.path);
                    p.sha256 = evidence.sha256;
                    p.hashState = evidence.hashState;
                    p.signature = evidence.signature;
                }
                CloseHandle(h);
                out.push_back(std::move(p));
            } while (Process32NextW(snap, &pe));
        }

        CloseHandle(snap);
        return out;
    }

    bool IsGameRunning() {
        auto list = EnumerateProcesses();
        for (const auto& p : list)
            if (ToLowerW(p.name) == ToLowerW(cfg_.gameProcess))
                return true;
        return false;
    }

    void ScannerLoop() {
        while (!stop_) {
            auto list = EnumerateProcesses();

            for (const auto& p : list) {
                std::string reason;
                int risk = CalculateRisk(p, reason);

                // Low-signal/unknown processes are NOT complaints.
                if (risk < 50) continue;

                std::string key = std::to_string(p.pid) + ":" + p.sha256 + ":" + std::to_string(risk);
                if (!reported_.insert(key).second) continue;

                std::ostringstream detail;
                detail << "risk=" << risk
                       << ";name=" << JsonEscapeW(p.name)
                       << ";pid=" << p.pid
                       << ";ppid=" << p.parentPid
                       << ";signature=";
                switch (p.signature) {
                case SignatureState::Valid: detail << "valid"; break;
                case SignatureState::Invalid: detail << "invalid"; break;
                default: detail << "unknown"; break;
                }
                detail << ";hash_state=" << (p.hashState == HashState::Valid ? "valid" : "unavailable")
                       << ";sha256=" << p.sha256
                       << ";path=" << JsonEscapeW(p.path)
                       << ";reason=" << reason;

                log_.Warn(detail.str());
                reporter_.SendEvent("process_alert", sessionId_, detail.str());
            }

            DWORD cs2Pid = FindGamePid();
            if (cs2Pid != 0 && !seenGame_) {
                seenGame_ = true;
                std::string detail = "pid=" + std::to_string(cs2Pid);
                reporter_.SendEvent("game_started_under_ac", sessionId_, detail);
                if (cfg_.showOverlay) std::thread(ShowOverlayForSeconds, 5).detach();
            }
            if (cs2Pid == 0) seenGame_ = false;

            std::this_thread::sleep_for(std::chrono::milliseconds(std::max(500, cfg_.scanIntervalMs)));
        }
    }

    void HeartbeatLoop() {
        while (!stop_) {
            bool game = IsGameRunning();
            std::ostringstream d;
            auto uptime = std::chrono::duration_cast<std::chrono::seconds>(std::chrono::steady_clock::now() - startedAt_).count();
            d << "game_running=" << (game ? "true" : "false")
              << ";ac_uptime_sec=" << uptime;
            reporter_.SendEvent("heartbeat", sessionId_, d.str());
            std::this_thread::sleep_for(std::chrono::milliseconds(std::max(1000, cfg_.heartbeatIntervalMs)));
        }
    }

    void WatchdogLoop() {
        while (!stop_) {
            reporter_.SendEvent("watchdog", sessionId_, "alive=true");
            std::this_thread::sleep_for(std::chrono::seconds(10));
        }
    }

    Config cfg_;
    Logger& log_;
    Reporter& reporter_;
    fs::path selfPath_;
    std::string sessionId_;
    std::chrono::steady_clock::time_point startedAt_ = std::chrono::steady_clock::now();
    std::unordered_map<std::wstring, CachedFile> fileCache_;
    std::unordered_set<std::string> reported_;
    bool seenGame_ = false;
    std::atomic<bool> stop_{false};
};

